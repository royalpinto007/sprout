---
import Base from '../layouts/Base.astro'
import Phone from '../components/Phone.astro'
import { FEATURES, FAQ } from '../data/app'
---

<Base path="/features" title="Features — Sprout" description="Forgiving streaks, gentle nudges, a garden that grows, and privacy by default.">
  <section class="relative overflow-hidden">
    <div class="blob h-72 w-72 bg-[var(--color-lilac)]" style="top:0;right:-4rem"></div>
    <div class="mx-auto max-w-6xl px-6 pt-36 pb-12 text-center sm:pt-44 lg:px-8">
      <p class="anim-rise u-label text-[var(--color-leaf-deep)]">Features</p>
      <h1 class="anim-rise mx-auto mt-5 max-w-2xl font-display text-5xl leading-[1.03] font-semibold tracking-tight sm:text-6xl" style="animation-delay:.08s">
        Everything you need, nothing that nags.
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {FEATURES.map((f, i) => (
        <div class="reveal rounded-3xl bg-[var(--color-card)] p-7 shadow-sm" data-d={String((i % 3) + 1)}>
          <div class="grid h-12 w-12 place-items-center rounded-2xl text-xl" style={`background:${f.tint}22`}>{f.icon}</div>
          <h3 class="mt-4 font-display text-xl font-semibold">{f.title}</h3>
          <p class="mt-2 text-[var(--color-dim)]">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Phone showcase -->
  <section class="mx-auto max-w-6xl px-6 py-24 lg:px-8">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="floaty reveal"><Phone /></div>
      <div class="reveal" data-d="2">
        <h2 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Your whole day, on one calm screen.</h2>
        <p class="mt-4 text-lg text-[var(--color-dim)]">Today's habits, your streaks, and a progress ring that fills as you go. Tap to check in. That's the whole ritual.</p>
        <ul class="mt-6 space-y-3">
          {['A grace day keeps a slip from becoming a spiral', 'Reminders you can snooze without a lecture', 'A plant for every habit you keep'].map((t) => (
            <li class="flex items-start gap-3"><span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[var(--color-leaf)] text-xs text-white">✓</span><span class="text-[var(--color-dim)]">{t}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-[var(--color-line)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-3xl px-6 py-24 lg:px-8">
      <h2 class="reveal text-center font-display text-4xl font-semibold tracking-tight sm:text-5xl">Questions, answered gently</h2>
      <div class="mt-10 space-y-3">
        {FAQ.map((f, i) => (
          <details class="reveal group rounded-2xl border border-[var(--color-line)] p-5" data-d={String((i % 2) + 1)}>
            <summary class="flex cursor-pointer items-center justify-between font-display text-lg font-semibold">
              {f.q}
              <span class="text-[var(--color-leaf-deep)] transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-[var(--color-dim)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
