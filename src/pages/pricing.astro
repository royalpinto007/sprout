---
import Base from '../layouts/Base.astro'
import { PLANS, FAQ } from '../data/app'
---

<Base path="/pricing" title="Pricing — Sprout" description="Free forever for five habits. Plus and Family add sync, sharing, and reflections.">
  <section class="relative overflow-hidden">
    <div class="blob h-72 w-72 bg-[var(--color-peach)]" style="top:0;left:-4rem"></div>
    <div class="mx-auto max-w-6xl px-6 pt-36 pb-12 text-center sm:pt-44 lg:px-8">
      <p class="anim-rise u-label text-[var(--color-leaf-deep)]">Pricing</p>
      <h1 class="anim-rise mt-5 font-display text-5xl font-semibold tracking-tight sm:text-6xl" style="animation-delay:.08s">Free to grow. Fair to flourish.</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      {PLANS.map((p, i) => (
        <div class:list={['reveal flex flex-col rounded-3xl p-8', p.featured ? 'bg-[var(--color-leaf-deep)] text-white shadow-[0_30px_70px_-30px_rgba(31,122,77,0.6)]' : 'bg-[var(--color-card)] shadow-sm']} data-d={String((i % 3) + 1)}>
          {p.featured && <span class="mb-3 w-fit rounded-full bg-white/20 px-3 py-1 text-xs font-bold">Most loved</span>}
          <h2 class="font-display text-2xl font-semibold">{p.name}</h2>
          <div class="mt-3 flex items-baseline gap-1"><span class="font-display text-5xl font-semibold">{p.price}</span><span class={p.featured ? 'text-sm text-white/70' : 'text-sm text-[var(--color-dim)]'}>/{p.period}</span></div>
          <p class={`mt-2 text-sm ${p.featured ? 'text-white/70' : 'text-[var(--color-dim)]'}`}>{p.note}</p>
          <ul class="mt-6 flex-1 space-y-3 text-sm">
            {p.perks.map((k) => (
              <li class="flex gap-2">
                <span class={p.featured ? 'text-[var(--color-peach)]' : 'text-[var(--color-leaf)]'}>✓</span>
                <span class={p.featured ? 'text-white/90' : 'text-[var(--color-dim)]'}>{k}</span>
              </li>
            ))}
          </ul>
          <a href="#" class:list={['mt-8 rounded-2xl px-5 py-3 text-center font-bold transition', p.featured ? 'bg-white text-[var(--color-leaf-deep)] hover:bg-[var(--color-mist)]' : 'bg-[var(--color-leaf)] text-white hover:bg-[var(--color-leaf-deep)]']}>{p.cta}</a>
        </div>
      ))}
    </div>
    <p class="reveal mt-8 text-center text-sm text-[var(--color-dim)]">All paid plans include a 14-day free trial. Cancel anytime, keep your garden.</p>
  </section>

  <section class="border-t border-[var(--color-line)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-3xl px-6 py-24 lg:px-8">
      <h2 class="reveal text-center font-display text-4xl font-semibold tracking-tight sm:text-5xl">Good to know</h2>
      <div class="mt-10 space-y-3">
        {FAQ.map((f, i) => (
          <details class="reveal group rounded-2xl border border-[var(--color-line)] p-5" data-d={String((i % 2) + 1)}>
            <summary class="flex cursor-pointer items-center justify-between font-display text-lg font-semibold">
              {f.q}
              <span class="text-[var(--color-leaf-deep)] transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-[var(--color-dim)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
